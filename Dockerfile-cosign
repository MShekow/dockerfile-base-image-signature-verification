ARG BASE_IMAGE=ghcr.io/mshekow/package-version-check-mcp:latest@sha256:2f65acaaf4bff2ce97b511675ae0f4183bd1135934561c8534647d3d3a37271c
ARG VERIFICATION_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.1.3-dev@sha256:3b1a2e2742351ab440255626f079a337e6c263249644800a52f5eaa389a5b730

FROM --platform=$BUILDPLATFORM ${VERIFICATION_IMAGE} AS verification-tooling
ARG VERIFICATION_IMAGE
SHELL ["/busybox/sh", "-c"]

# Trust Sigstore's release signer and verify the tooling image.
RUN cosign verify \
      --certificate-identity="keyless@projectsigstore.iam.gserviceaccount.com" \
      --certificate-oidc-issuer="https://accounts.google.com" \
      "$VERIFICATION_IMAGE"

FROM verification-tooling AS verification
ARG BASE_IMAGE
ARG CERTIFICATE_IDENTITY_REGEXP="^https://github[.]com/MShekow/package-version-check-mcp/[.]github/workflows/ci-cd[.]yml@refs/tags/v[0-9]+[.][0-9]+[.][0-9]+$"
ARG CERTIFICATE_OIDC_ISSUER="https://token.actions.githubusercontent.com"

RUN cosign verify \
      --certificate-identity-regexp="$CERTIFICATE_IDENTITY_REGEXP" \
      --certificate-oidc-issuer="$CERTIFICATE_OIDC_ISSUER" \
      "$BASE_IMAGE" \
    && touch /home/nonroot/verified

FROM ${BASE_IMAGE} AS build
COPY --from=verification /home/nonroot/verified /verified
